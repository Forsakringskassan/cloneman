{
    "$schema": "https://www.schemastore.org/tsconfig",

    "compilerOptions": {
        /* use latest versions, consumer can downgrade if they have more
         * specific requirements */
        "lib": ["esnext"],
        "module": "nodenext",
        "moduleResolution": "node16",
        "target": "esnext",

        /* dont pull node by default, we dont want template authors to use node
         * features directly but what is supplied to them by the hook context */
        "types": [],

        /* allow and check js files as well */
        "allowJs": true,
        "checkJs": true,

        /* allows template authors to import "package.json" */
        "resolveJsonModule": true,

        /* typecheck only, the scripts are typestripped before they reach the
         * end user */
        "noEmit": true,

        "rootDir": "${configDir}",
        "strict": true,
        "skipLibCheck": true
    },

    /* include all supported files in the current folder */
    "include": ["${configDir}/**/*"]
}
